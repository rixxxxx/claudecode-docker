# syntax=docker/dockerfile:1
#
# Optional runtime security monitoring for claude-code, via Falco
# (eBPF-based syscall observation) + a local desktop notification relay
# (falco-notify.sh, via the host's D-Bus session bus). Only built/started
# via the "monitoring" Compose profile (never by default, never affects
# claude-code's own privileges) -- see README "Runtime monitoring
# (optional)" and AGENTS.md.
#
# Verified against a live build (Falco 0.39.2, 2026-09-11): base image
# pulls fine, apt is the package manager, engine.kind/program_output keys
# are correct (see falco/falco.yaml's own verification note for the two
# corrections found: rules_files plural, outputs.rate/max_burst removed).
#
# Switched 2026-09-15 from falcosecurity/falco-no-driver:latest to
# falcosecurity/falco:latest-debian: `falco-no-driver` turned out to be a
# retired image name -- falcosecurity/falco's own docker/README.md (commit
# a2122621, 2024-10-30) describes the current falco-debian image as
# "similar to the OLD falcosecurity/falco-no-driver image", i.e. no longer
# updated. Confirmed live: `falco-no-driver:latest` still resolved to
# Falco 0.39.2 (released 2024-11-21) as of this date, while 0.44.1 was the
# latest real release -- explains why several syscalls (mount, umount2,
# unshare, capset) weren't visible to rule evaluation in this repo's own
# Falco rules despite matching upstream's own documented behavior for
# newer versions (see falco/claude-code-rules.yaml OPEN ITEMS for the
# investigation this uncovered). `falco:*-debian` is Debian-based with the
# same apt-get availability this Dockerfile already depends on below.
#
# util-linux (for setpriv) is needed by falco-notify.sh: this container
# runs as root (the one deliberate privileged exception in this repo, see
# AGENTS.md), but the host's D-Bus session bus belongs to a specific
# non-root host user (HOST_UID) -- D-Bus's EXTERNAL auth checks the
# connecting process's actual peer credentials (kernel SO_PEERCRED), so a
# root notify-send gets its connection closed immediately ("The connection
# is closed") even with DBUS_SESSION_BUS_ADDRESS pointed at the right
# socket. falco-notify.sh uses setpriv to actually become HOST_UID before
# calling notify-send, which is the only thing D-Bus will accept.

FROM falcosecurity/falco:latest-debian

# procps is for pgrep, used by this service's healthcheck in
# docker-compose.yml (claude-code's depends_on waits on it).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnotify-bin \
    util-linux \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY falco/falco.yaml /etc/falco/falco.yaml
COPY falco/claude-code-rules.yaml /etc/falco/rules.d/claude-code-rules.yaml
COPY falco-notify.sh /usr/local/bin/falco-notify.sh
RUN chmod +x /usr/local/bin/falco-notify.sh
