# Dependencies
node_modules/
.npm/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
# .squid-empty-bump-ca/ is the deliberate exception (see below): a tracked,
# never-trusted placeholder keypair, not a real secret.
!.squid-empty-bump-ca/ca.key

# Claude Code / OAuth credentials (if mounted locally, never commit)
.claude/
.credentials.json

# Generated per-host enterprise proxy config (may contain credentials,
# regenerated by bin/cc-container on every run — never commit)
.squid-upstream-proxy/

# Generated per-host SSL-Bump CA (bin/generate-bump-ca.sh) — unlike a
# shared enterprise CA in certs/, this keypair is host-unique and its
# private key must never be committed (see that script's own comment).
# certs/egress-proxy-bump-ca.crt is a synced copy of the same public cert,
# ignored separately since certs/*.crt is otherwise intentionally
# trackable (shared enterprise CAs).
.squid-bump-ca/
certs/egress-proxy-bump-ca.crt

# Build artifacts
dist/
build/
*.log

# OS/editor cruft
.DS_Store
.vscode/
.idea/
*.swp

# Docker
*.pid

# Python (if used in the project)
__pycache__/
*.pyc
.venv/
venv/

# Windows onboarding installer build output (windows/build.sh)
windows/claudecode-sandbox-setup.exe

# Local Ubuntu WSL image + SHA256SUMS(.gpg) for windows/ -rootfs-file testing (~400 MB)
wsl-image/
