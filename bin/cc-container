#!/usr/bin/env bash
# Starts the Claude Code docker-compose stack (if not already running) and
# drops you straight into the `claude` console inside the container.
# Pass --update (optionally followed by --force) to run bin/update-deps.sh
# first, e.g. `cc-container --update` or `cc-container --update --force`.
#
# Structured as sourceable pure functions (below) + main() (at the bottom),
# guarded so `source bin/cc-container` (e.g. from tests/) only defines
# functions -- no side effects -- while running it directly behaves exactly
# as before. See tests/unit/test_render_upstream_proxy_conf.sh and
# tests/unit/test_compose_project_name.sh.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Derives a stable, unique Compose project name from a workspace path so
# each distinct host workspace gets its own containers, networks, and
# dedicated egress-proxy (true parallelism), while repeated runs from the
# same workspace reuse the same project instead of piling up duplicates.
# The literal "cc-" prefix guarantees the result always starts with an
# alnum char, satisfying Compose's ^[a-z0-9][a-z0-9_-]*$ project-name rule
# even if the slug ends up empty.
derive_compose_project_name() {
    local host_workspace="$1"
    local slug hash
    slug="$(basename "$host_workspace" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
        | cut -c1-32)"
    hash="$(printf '%s' "$host_workspace" | cksum | cut -d' ' -f1)"
    echo "cc-${slug:-ws}-${hash}"
}

# ensure_squid_upstream_dir -- creates $PROJECT_ROOT/.squid-upstream-proxy
# (as the invoking host user) if missing and chmods it 700, echoing its
# path. Used by both render_upstream_proxy_conf() and
# render_build_secret_files() below, which write into the same directory.
# If it already exists but isn't writable by the current user -- e.g. an
# older docker-compose.yml let Docker auto-create it as root as a
# bind-mount source before this fallback pattern existed here, the exact
# footgun already documented for .squid-claudecode-docker in main() below
# -- fail with a clear, actionable message instead of a bare `chmod:
# Operation not permitted` under set -e.
ensure_squid_upstream_dir() {
    local conf_dir="$PROJECT_ROOT/.squid-upstream-proxy"
    mkdir -p "$conf_dir" 2>/dev/null || true

    if [ ! -w "$conf_dir" ]; then
        echo "Error: $conf_dir exists but isn't writable by $(whoami)." >&2
        echo "       This can happen if Docker auto-created it as root as a bind-mount" >&2
        echo "       source before it existed (see AGENTS.md). Fix once with:" >&2
        echo "         sudo rm -rf '$conf_dir'" >&2
        exit 1
    fi

    chmod 700 "$conf_dir"
    echo "$conf_dir"
}

# Enterprise proxy chaining (see README "Enterprise proxy support"): renders
# .squid-upstream-proxy/{upstream.conf,px.ini} from HTTP(S)_PROXY/
# ENTERPRISE_PROXY_AUTH in .env/the environment. Empty HTTP(S)_PROXY is a
# no-op (egress-proxy keeps connecting directly to the internet, unchanged
# default behavior). Sets NEEDS_PROXY_AUTH_SIDECAR=true when NTLM/Kerberos
# auth needs the proxy-auth (px) sidecar -- Basic auth doesn't, Squid's own
# cache_peer login= handles that directly. Expects PROJECT_ROOT and
# NEEDS_PROXY_AUTH_SIDECAR to already be set by the caller.
render_upstream_proxy_conf() {
    local conf_dir
    conf_dir="$(ensure_squid_upstream_dir)"
    local upstream_conf="$conf_dir/upstream.conf"
    local px_ini="$conf_dir/px.ini"
    local px_env="$conf_dir/px.env"
    # -rf, not -f: if `docker compose run`/`up` ever touched these mount
    # targets before this function first rendered them as real files,
    # Docker auto-creates the bind-mount source as an (empty) directory --
    # same footgun as ensure_squid_upstream_dir() above, just one level
    # deeper. Safe to blow away unconditionally: both paths are exclusively
    # owned/rendered by this function.
    rm -rf "$px_ini" "$px_env"

    # Compose falls back to ./.squid-empty (the same tracked placeholder
    # used for SQUID_WORKSPACE_DIR) when this isn't exported -- e.g. when
    # docker compose is invoked directly, bypassing cc-container entirely
    # (as tests/integration/test_runtime.sh and
    # tests/security/test_runtime_hardening.sh deliberately do). Without
    # this, a missing/empty .squid-upstream-proxy/ would make Squid's
    # `include .../upstream/*.conf` match zero files, which can prevent
    # Squid from starting at all -- confirmed by a real test run.
    export SQUID_UPSTREAM_PROXY_DIR="$conf_dir"

    local proxy_url="${HTTPS_PROXY:-${HTTP_PROXY:-}}"
    if [ -z "$proxy_url" ]; then
        printf '# No enterprise proxy configured (HTTP_PROXY/HTTPS_PROXY unset in\n# .env) -- egress-proxy connects directly to the internet.\n' \
            > "$upstream_conf"
        chmod 600 "$upstream_conf"
        return
    fi

    # http://[user[:password]@]host:port -- user/password may contain a
    # literal backslash unencoded (DOMAIN\username for NTLM).
    if [[ ! "$proxy_url" =~ ^https?://(([^:@/]+)(:([^@/]*))?@)?([^:@/]+):([0-9]+)/?$ ]]; then
        echo "Warning: HTTP_PROXY/HTTPS_PROXY ('$proxy_url') is not of the form" >&2
        echo "         http://[user[:password]@]host:port -- ignoring it." >&2
        printf '# HTTP_PROXY/HTTPS_PROXY set but not parseable -- ignored, see\n# cc-container output.\n' > "$upstream_conf"
        chmod 600 "$upstream_conf"
        return
    fi

    local proxy_user="${BASH_REMATCH[2]}" proxy_pass="${BASH_REMATCH[4]}"
    local proxy_host="${BASH_REMATCH[5]}" proxy_port="${BASH_REMATCH[6]}"
    local auth_scheme="${ENTERPRISE_PROXY_AUTH:-basic}"

    case "$auth_scheme" in
        ntlm|kerberos|basic) ;;
        *)
            echo "Warning: unknown ENTERPRISE_PROXY_AUTH='$auth_scheme' (expected basic|ntlm|kerberos) -- treating as 'basic'." >&2
            auth_scheme=basic
            ;;
    esac

    {
        echo "# Generated by bin/cc-container from HTTP(S)_PROXY in .env -- do not edit."
        echo "# Regenerated on every cc-container run, not version controlled."
        if [ "$auth_scheme" = basic ]; then
            if [ -n "$proxy_user" ]; then
                echo "cache_peer $proxy_host parent $proxy_port 0 no-query default login=${proxy_user}:${proxy_pass}"
            else
                echo "cache_peer $proxy_host parent $proxy_port 0 no-query default"
            fi
        else
            # ntlm/kerberos: Squid chains to the local proxy-auth (px)
            # sidecar instead, which handles auth against the real
            # corporate proxy itself -- see px.ini rendered below.
            echo "cache_peer proxy-auth parent 3128 0 no-query default"
        fi
        echo "never_direct allow all"
    } > "$upstream_conf"
    chmod 600 "$upstream_conf"

    if [ "$auth_scheme" != basic ]; then
        NEEDS_PROXY_AUTH_SIDECAR=true
        {
            echo "[proxy]"
            echo "server = ${proxy_host}:${proxy_port}"
            if [ -n "$proxy_user" ]; then
                echo "username = ${proxy_user}"
            fi
            echo "listen = 0.0.0.0"
            echo "port = 3128"
            echo "gateway = 1"
            echo "allow = 0.0.0.0/0"
        } > "$px_ini"
        chmod 600 "$px_ini"

        # px has no `password` key for px.ini -- confirmed against a real
        # `px --help` (see AGENTS.md "Enterprise proxy support"): it only
        # accepts a password via --password (interactive, writes to the OS
        # keyring) or the PX_PASSWORD env var. Rendered here as a separate
        # chmod-600 file instead of embedding it in px.ini, where px would
        # have silently ignored it -- proxy-auth-entrypoint.sh sources this
        # before exec'ing px.
        {
            if [ -n "$proxy_pass" ]; then
                echo "PX_PASSWORD=${proxy_pass}"
            fi
        } > "$px_env"
        chmod 600 "$px_env"
    fi
}

# Renders the three build-time proxy secret files consumed by Dockerfile/
# Dockerfile.proxy-auth via BuildKit --mount=type=secret (see
# docker-compose.yml's top-level secrets: block), and exports the
# *_SECRET_FILE vars docker-compose.yml points at, so the docker compose
# child process picks up these real files instead of the empty fallback.
# Passed as secrets rather than build args because ARG values persist in
# `docker history`/image metadata even though never written to the image
# filesystem -- that would leak a corporate proxy password baked into a
# shared image (see AGENTS.md "Enterprise proxy support"). Expects
# PROJECT_ROOT to already be set by the caller.
render_build_secret_files() {
    local conf_dir
    conf_dir="$(ensure_squid_upstream_dir)"
    printf '%s' "${HTTP_PROXY:-}" > "$conf_dir/http_proxy.secret"
    printf '%s' "${HTTPS_PROXY:-}" > "$conf_dir/https_proxy.secret"
    printf '%s' "${NO_PROXY:-}" > "$conf_dir/no_proxy.secret"
    chmod 600 "$conf_dir/http_proxy.secret" "$conf_dir/https_proxy.secret" "$conf_dir/no_proxy.secret"

    export HTTP_PROXY_SECRET_FILE="$conf_dir/http_proxy.secret"
    export HTTPS_PROXY_SECRET_FILE="$conf_dir/https_proxy.secret"
    export NO_PROXY_SECRET_FILE="$conf_dir/no_proxy.secret"
}

# sync_proxy_auth_sidecar -- keeps the proxy-auth (px) sidecar in sync with
# the current enterprise-proxy configuration. Called from both main() below
# and update-deps.sh (standalone entry point), so both ways of running this
# repo behave the same regardless of whether .env currently configures an
# enterprise proxy or not.
#
# NEEDS_PROXY_AUTH_SIDECAR=true: does a plain cached `docker compose build`
# for proxy-auth so it always picks up local Dockerfile.proxy-auth/
# entrypoint/certs edits -- Docker's own layer cache makes this a no-op
# when nothing changed (confirmed: this is what was missing when
# `docker compose up -d proxy-auth` alone kept running a 9-hour-old image
# after the entrypoint's --config flag was fixed). The `up -d` that follows
# then recreates the container automatically if the build produced a new
# image ID -- but px.ini/px.env are bind-mounted by host path, so editing
# just their *content* (e.g. a rotated corporate-proxy password) doesn't
# change the mount spec Compose hashes to decide whether a recreate is
# needed, and px itself only reads them once at startup
# (proxy-auth-entrypoint.sh). So if proxy-auth is already running, restart
# it explicitly -- same container, same mounts, but the entrypoint re-runs
# and re-reads the current file contents. Cheaper than --force-recreate and
# doesn't depend on Compose noticing anything changed.
#
# NEEDS_PROXY_AUTH_SIDECAR=false: a leftover proxy-auth container from an
# earlier enterprise-mode session is stopped/removed and egress-proxy is
# force-recreated. Without this, `up -d` without --profile enterprise-proxy
# leaves a still-running proxy-auth container untouched (Compose doesn't
# stop containers for profiles that simply aren't requested), and
# egress-proxy keeps its old in-memory Squid config chained through it --
# so clearing HTTP_PROXY/ENTERPRISE_PROXY_AUTH from .env wouldn't actually
# take effect until a manual restart.
#
# Expects PROJECT_ROOT and NEEDS_PROXY_AUTH_SIDECAR to already be set by
# the caller (see render_upstream_proxy_conf() above).
sync_proxy_auth_sidecar() {
    if [ "$NEEDS_PROXY_AUTH_SIDECAR" = true ]; then
        echo "==> Rebuilding proxy-auth (px) image (cached -- picks up local Dockerfile.proxy-auth/entrypoint/certs changes)..."
        docker compose --profile enterprise-proxy build proxy-auth

        if [ -n "$(docker compose --profile enterprise-proxy ps -q proxy-auth 2>/dev/null)" ]; then
            echo "==> Restarting proxy-auth so it re-reads px.ini/px.env..."
            docker compose --profile enterprise-proxy restart proxy-auth
        fi
    elif [ -n "$(docker compose --profile enterprise-proxy ps -q proxy-auth 2>/dev/null)" ]; then
        echo "==> Enterprise proxy no longer configured -- stopping leftover proxy-auth sidecar and recreating egress-proxy..."
        docker compose --profile enterprise-proxy rm -s -f proxy-auth
        docker compose up -d --force-recreate egress-proxy
    fi
}

# image_id -- current image ID for a tag, or empty if it doesn't exist
# locally. Shared helper (originally update-deps.sh-local): used there for
# the ubuntu/python base-image drift checks, and here by
# sync_security_monitor_sidecar to detect whether a build actually produced
# a new image before deciding to disrupt a running container over it.
image_id() {
    docker image inspect "$1" --format='{{.Id}}' 2>/dev/null || echo ""
}

# sync_security_monitor_sidecar -- keeps the optional security-monitor
# (Falco) sidecar image in sync with local edits to
# Dockerfile.security-monitor, falco/*.yaml, and falco-notify.sh. Called
# from update-deps.sh (i.e. `cc-container --update`) so "everything is up
# to date" also covers this sidecar, not just claude-code/proxy-auth -- see
# AGENTS.md "Runtime monitoring". Also called directly from main() whenever
# --monitor is passed (with or without --update, see below) -- see that
# call site for why. Same reasoning as
# sync_proxy_auth_sidecar's build above: a plain cached `docker compose
# build` is a no-op when nothing changed and picks up local edits when
# something did, via Docker's own layer-checksum cache invalidation -- no
# custom diffing needed. Confirmed necessary on a real host (2026-09-11):
# cc-container --monitor never called build at all, only up -d, so a
# rebuilt Dockerfile.security-monitor/falco.yaml silently kept running the
# stale image until a manual `docker compose build --no-cache
# security-monitor`.
#
# Only force-recreates a running security-monitor if the build actually
# produced a new image ID -- otherwise every `--update` would restart Falco
# (losing a few seconds of monitoring coverage) even when nothing changed,
# since `docker compose build` runs unconditionally every time regardless
# of whether it was a cache-hit no-op.
sync_security_monitor_sidecar() {
    local image_before image_after
    image_before="$(image_id claude-code-security-monitor:latest)"

    echo "==> Rebuilding security-monitor (Falco) image (cached -- picks up local Dockerfile.security-monitor/falco/*.yaml/falco-notify.sh changes)..."
    docker compose --profile monitoring build security-monitor

    image_after="$(image_id claude-code-security-monitor:latest)"

    if [ "$image_before" != "$image_after" ] \
        && [ -n "$(docker compose --profile monitoring ps -q security-monitor 2>/dev/null)" ]; then
        echo "==> security-monitor image changed -- recreating so it picks up the new image..."
        docker compose --profile monitoring up -d --force-recreate security-monitor
    fi
}

# sync_stop_watcher_sidecar -- same treatment as sync_security_monitor_sidecar
# above, for the stop-watcher companion service (see docker-compose.yml and
# AGENTS.md "Runtime monitoring"). Kept in sync with local
# Dockerfile.stop-watcher/stop-watcher-entrypoint.sh edits regardless of
# whether --monitor ends up starting it this particular invocation (see
# main()'s SECURITY_MONITOR_STOP_THRESHOLD check).
sync_stop_watcher_sidecar() {
    local image_before image_after
    image_before="$(image_id claude-code-stop-watcher:latest)"

    echo "==> Rebuilding stop-watcher image (cached -- picks up local Dockerfile.stop-watcher/stop-watcher-entrypoint.sh changes)..."
    docker compose --profile auto-stop build stop-watcher

    image_after="$(image_id claude-code-stop-watcher:latest)"

    if [ "$image_before" != "$image_after" ] \
        && [ -n "$(docker compose --profile auto-stop ps -q stop-watcher 2>/dev/null)" ]; then
        echo "==> stop-watcher image changed -- recreating so it picks up the new image..."
        docker compose --profile auto-stop up -d --force-recreate stop-watcher
    fi
}

main() {
    # docker compose auto-loads .env for its own ${...} interpolation, but
    # this script also needs HTTP_PROXY/HTTPS_PROXY/ENTERPRISE_PROXY_AUTH at
    # the bash level below (to render the Squid/px config), so load it
    # explicitly here too. See README "Enterprise proxy support".
    if [ -f "$PROJECT_ROOT/.env" ]; then
        set -a
        # shellcheck disable=SC1091
        source "$PROJECT_ROOT/.env"
        set +a
    fi

    export HOST_WORKSPACE="$(pwd -P)"

    # Used by the optional security-monitor service (see docker-compose.yml
    # and AGENTS.md "Runtime monitoring") to bind-mount the invoking host
    # user's D-Bus session bus for desktop notifications.
    export HOST_UID="$(id -u)"

    # Per-workspace Squid additions: mount the target workspace's own
    # .squid-claudecode-docker/ folder into the egress-proxy alongside this
    # repo's defaults. Create it here (as the invoking host user) if it
    # doesn't exist yet, rather than letting Docker auto-create the
    # bind-mount source — Docker would create it as root, leaving it
    # unwritable by the user for future edits. An empty folder has the same
    # effect as the old .squid-empty/ placeholder fallback (no extra
    # domains). The "-claudecode-docker" suffix keeps this unambiguous in
    # case a workspace ever has an unrelated ".squid" folder of its own for
    # something else.
    mkdir -p "$HOST_WORKSPACE/.squid-claudecode-docker"
    export SQUID_WORKSPACE_DIR="$HOST_WORKSPACE/.squid-claudecode-docker"

    export COMPOSE_PROJECT_NAME="$(derive_compose_project_name "$HOST_WORKSPACE")"

    echo "==> Workspace:       $HOST_WORKSPACE"
    echo "==> Compose project: $COMPOSE_PROJECT_NAME"

    cd "$PROJECT_ROOT"

    NEEDS_PROXY_AUTH_SIDECAR=false
    render_upstream_proxy_conf
    render_build_secret_files

    compose_profile_args=()
    if [ "$NEEDS_PROXY_AUTH_SIDECAR" = true ]; then
        compose_profile_args=(--profile enterprise-proxy)
        echo "==> Enterprise proxy: chaining egress-proxy through proxy-auth (${ENTERPRISE_PROXY_AUTH})"
    fi

    # --monitor is stripped out here (order-independent, works combined
    # with --update) rather than handled inline below, since it toggles a
    # Compose profile rather than delegating to another script. See
    # docker-compose.yml's security-monitor service and AGENTS.md "Runtime
    # monitoring".
    local monitor_enabled=false
    local auto_stop_enabled=false
    local remaining_args=()
    for arg in "$@"; do
        if [ "$arg" = "--monitor" ]; then
            monitor_enabled=true
        else
            remaining_args+=("$arg")
        fi
    done
    set -- "${remaining_args[@]}"

    if [ "$monitor_enabled" = true ]; then
        compose_profile_args+=(--profile monitoring)
        echo "==> Runtime monitoring: starting security-monitor (Falco)"

        # stop-watcher (see docker-compose.yml and AGENTS.md "Runtime
        # monitoring") rides along with --monitor automatically -- no
        # separate flag. SECURITY_MONITOR_STOP_THRESHOLD is sourced from
        # .env above (set -a/source/set +a); the only way to keep
        # stop-watcher from starting at all is setting it to exactly "0"
        # there. A raw `docker compose --profile monitoring up -d` (no
        # --profile auto-stop, bypassing cc-container) still leaves
        # stop-watcher off by default -- this auto-add only happens here.
        if [ "${SECURITY_MONITOR_STOP_THRESHOLD:-3}" != "0" ]; then
            compose_profile_args+=(--profile auto-stop)
            auto_stop_enabled=true
            echo "==> Auto-stop: starting stop-watcher (stops claude-code after \${SECURITY_MONITOR_STOP_THRESHOLD:-3} CRITICAL alerts; set SECURITY_MONITOR_STOP_THRESHOLD=0 in .env to disable)"
        fi
    fi

    if [ "${1:-}" = "--update" ]; then
        shift
        "$SCRIPT_DIR/update-deps.sh" "$@"
    fi

    sync_proxy_auth_sidecar

    # Same reasoning as sync_proxy_auth_sidecar above, and previously only
    # wired into `cc-container --update` (via update-deps.sh) -- confirmed
    # live (2026-09-16) that plain `--monitor` without `--update` has the
    # exact same stale-image gap sync_security_monitor_sidecar's own
    # comment already documents: a cached `up -d` here silently kept
    # running security-monitor's image from before a
    # Dockerfile.security-monitor/falco/*.yaml edit, with `--force-recreate`
    # unable to fix it since that only recreates the *container* from the
    # already-stale *image*. Called here too so the actually-documented
    # `--monitor` workflow is covered, not just `--update`.
    if [ "$monitor_enabled" = true ]; then
        sync_security_monitor_sidecar
        if [ "$auto_stop_enabled" = true ]; then
            sync_stop_watcher_sidecar
        fi
    fi

    docker compose "${compose_profile_args[@]}" up -d

    set +e
    docker compose exec claude-code claude
    claude_status=$?
    set -e

    if [ -t 0 ]; then
        read -r -p "Close containers for this workspace (claude-code + egress-proxy)? [y/N] " reply
        case "$reply" in
            y|Y|yes|Yes)
                echo "==> Stopping and removing containers..."
                docker compose "${compose_profile_args[@]}" down
                ;;
            *)
                echo "==> Leaving containers running. Stop them later with: docker compose down"
                ;;
        esac
    fi

    exit "$claude_status"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
