# Copy to .env and uncomment/fill in what you need. Everything here is
# optional — an empty or missing .env is the normal, non-enterprise setup.

# Authenticate Claude Code with an API key instead of running /login inside
# the container.
# ANTHROPIC_API_KEY=

# --- Enterprise / corporate proxy (see README "Enterprise proxy support") ---
#
# Set these if your network requires all outbound traffic to go through a
# corporate forward proxy. Used both as Docker build-time proxy args (apt,
# curl, npm, gh, rtk, px all fetch over the network during image build) and,
# parsed by bin/cc-container, to chain egress-proxy's outbound connections
# through the same proxy at runtime. Standard URL form; for NTLM include the
# domain in the username as DOMAIN\username -- no URL-encoding needed, but
# since bin/cc-container loads this file via bash `source`, the backslash
# itself must be doubled (DOMAIN\\username) or it's silently stripped
# (confirmed by a live test: DOMAIN\username became DOMAINusername).
#
# HTTP_PROXY=http://user:password@proxy.corp.example.com:8080
# HTTPS_PROXY=http://user:password@proxy.corp.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Corporate proxy authentication scheme: basic | ntlm | kerberos
# (default: basic). NTLM/Kerberos are handled by the proxy-auth sidecar
# (px) — see README.
# ENTERPRISE_PROXY_AUTH=basic

# Only needed when ENTERPRISE_PROXY_AUTH=kerberos: host paths to an
# existing Kerberos ticket cache (obtained via `kinit` on the host) and
# krb5.conf, bind-mounted read-only into the proxy-auth sidecar. Linux
# hosts only — Windows/macOS domain SSO passthrough isn't supported.
# KRB5_CCNAME_PATH=/tmp/krb5cc_1000
# KRB5_CONFIG_PATH=/etc/krb5.conf

# --- Runtime monitoring (see README "Runtime monitoring (optional)") ---
#
# Only takes effect when security-monitor is running (the "monitoring"
# Compose profile / `cc-container --monitor`). Controls only the native
# desktop notification popup (falco-notify.sh) -- alerts always keep
# landing in `docker logs security-monitor` regardless of this setting.
# Deliberately host-side only (read by docker compose from this file, not
# mounted into the claude-code container) so the sandboxed agent can never
# see or flip its own alarm. Default: enabled.
# SECURITY_MONITOR_NOTIFY=false

# How long (in milliseconds) the popup stays on screen for non-critical
# alerts (Warning/Notice/Informational/Debug) before it closes itself, like
# a toaster. Critical/Emergency alerts always ignore this and stay until
# dismissed by hand, so the most important alerts can't be missed while
# looking away. Default: 8000 (8s).
# SECURITY_MONITOR_NOTIFY_TIMEOUT=8000

# Number of CRITICAL/EMERGENCY alerts attributed to claude-code (see
# falco/claude-code-rules.yaml) before the claude-code container gets
# stopped automatically. `cc-container --monitor` starts stop-watcher
# alongside security-monitor automatically to act on this -- set this to
# exactly 0 to opt back out (cc-container then skips starting stop-watcher
# entirely, so no docker.sock-bearing container runs at all; see AGENTS.md
# "Runtime monitoring" for why that access lives in a separate, minimal
# service instead of security-monitor itself). Default: 3.
#
# Only cc-container reads this to decide whether to start stop-watcher --
# a raw `docker compose --profile monitoring --profile auto-stop up -d`
# (bypassing cc-container) always starts it regardless of this value; here
# it then only controls whether the trigger ever fires.
# SECURITY_MONITOR_STOP_THRESHOLD=3
